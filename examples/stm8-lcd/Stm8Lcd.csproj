<Project Sdk="Microsoft.NET.Sdk">
  <!-- A potentiometer's reading and voltage on a 16x2 LCD on I2C, with no heap: build with ChipSharp for the target
       "stm8s103-board" (see Program.cs) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Adc, I2c and Timing: the board's hardware from C#; Lcd: a part connected to it, which ChipSharp compiles with
         the program -->
    <ProjectReference Include="..\..\src\ChipSharp.Hardware\ChipSharp.Hardware.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Components\ChipSharp.Components.csproj" />
  </ItemGroup>
</Project>
