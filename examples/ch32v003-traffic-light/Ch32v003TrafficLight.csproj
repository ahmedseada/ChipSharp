<Project Sdk="Microsoft.NET.Sdk">
  <!-- A traffic light with a 7-segment countdown and a pedestrian button, with no heap, on WCH's CH32V003 evaluation
       board: build with ChipSharp for the target "ch32v003-evt", flash the .bin with chipsharp flash and a WCH-LinkE
       (see Program.cs) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin, Timing and [Interrupt]: the board's hardware from C#; SevenSegment: a part connected to it, which
         ChipSharp compiles with the program -->
    <ProjectReference Include="..\..\src\ChipSharp.Hardware\ChipSharp.Hardware.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Components\ChipSharp.Components.csproj" />
  </ItemGroup>
</Project>
