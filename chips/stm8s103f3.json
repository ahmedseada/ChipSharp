  },
  "ports": {
    "A": { "registers": { "out": "PA_ODR", "in": "PA_IDR", "direction": "PA_DDR", "control1": "PA_CR1", "control2": "PA_CR2" } },
    "B": { "registers": { "out": "PB_ODR", "in": "PB_IDR", "direction": "PB_DDR", "control1": "PB_CR1", "control2": "PB_CR2" } },
    "C": { "registers": { "out": "PC_ODR", "in": "PC_IDR", "direction": "PC_DDR", "control1": "PC_CR1", "control2": "PC_CR2" } },
