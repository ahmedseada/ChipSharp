<Project Sdk="Microsoft.NET.Sdk">
  <!-- The runtime of PC programs (target "host"): startup and console output in freestanding C -->
  <ItemGroup>
    <ProjectReference Include="..\ChipSharp.Abstractions\ChipSharp.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="chipsharp_runtime.c" LogicalName="chipsharp_runtime.c" />
    <!-- Console.Write and Console.WriteLine, shared with the other runtimes -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_console.c" LogicalName="chipsharp_console.c" />
    <!-- float and double as text, shared with the other runtimes -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_float_text.c" LogicalName="chipsharp_float_text.c" />
    <!-- fmod and the Math methods, shared with the other runtimes -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_float_math.c" LogicalName="chipsharp_float_math.c" />
    <EmbeddedResource Include="chipsharp_failures.c" LogicalName="chipsharp_failures.c" />
    <EmbeddedResource Include="chipsharp_memory.c" LogicalName="chipsharp_memory.c" />
    <EmbeddedResource Include="chipsharp_chkstk.S" LogicalName="chipsharp_chkstk.S" />
    <!-- objects, the allocator and the garbage collector, shared with the other runtimes; and what they need from Windows -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_heap.c" LogicalName="chipsharp_heap.c" />
    <EmbeddedResource Include="chipsharp_heap_windows.c" LogicalName="chipsharp_heap_windows.c" />
    <!-- strings, shared with the other runtimes: what reads them, and what makes them (a target with a heap) -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_string.c" LogicalName="chipsharp_string.c" />
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_string_heap.c" LogicalName="chipsharp_string_heap.c" />
  </ItemGroup>
</Project>
