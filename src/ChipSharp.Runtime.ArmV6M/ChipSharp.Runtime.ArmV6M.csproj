<Project Sdk="Microsoft.NET.Sdk">
  <!-- The runtime parts every ARMv6-M chip (Cortex-M0/M0+) shares: reset handler, vector table, divide/multiply/shift helpers, float math -->
  <ItemGroup>
    <ProjectReference Include="..\ChipSharp.Abstractions\ChipSharp.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="armv6m_startup.c" LogicalName="armv6m_startup.c" />
    <EmbeddedResource Include="armv6m_vectors.c" LogicalName="armv6m_vectors.c" />
    <EmbeddedResource Include="armv6m_helpers.c" LogicalName="armv6m_helpers.c" />
    <EmbeddedResource Include="armv6m_divmod.S" LogicalName="armv6m_divmod.S" />
    <EmbeddedResource Include="armv6m_float_compare.c" LogicalName="armv6m_float_compare.c" />
    <EmbeddedResource Include="armv6m_failures.c" LogicalName="armv6m_failures.c" />
    <!-- objects, the allocator and the garbage collector, shared with the other runtimes; and what they need from the chip -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_heap.c" LogicalName="chipsharp_heap.c" />
    <EmbeddedResource Include="armv6m_heap.c" LogicalName="armv6m_heap.c" />
    <!-- strings, shared with the other runtimes: what reads them (every target) and what makes them (a target with a heap,
         which writes floats into them with the text of floats) -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_string.c" LogicalName="chipsharp_string.c" />
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_string_heap.c" LogicalName="chipsharp_string_heap.c" />
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_float_text.c" LogicalName="chipsharp_float_text.c" />
    <!-- C#'s throw, shared with the other runtimes (a target with a heap: an exception is an object) -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_exceptions.c" LogicalName="chipsharp_exceptions.c" />
    <!-- fmod, square roots, Math.Min and the like, shared with the other runtimes -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_float_math.c" LogicalName="chipsharp_float_math.c" />
    <!-- the transcendental functions of Math and MathF, shared with the other runtimes: ChipSharp's entry points, and the
         functions from musl (MIT) and from AMD's math library (BSD-3-Clause), each file with its license -->
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_math.c" LogicalName="chipsharp_math.c" />
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_math_musl.c" LogicalName="chipsharp_math_musl.c" />
    <EmbeddedResource Include="..\ChipSharp.Runtime.Shared\chipsharp_math_amd.c" LogicalName="chipsharp_math_amd.c" />
    <!-- float arithmetic in software: LLVM's compiler-rt builtins (llvmorg-23.1.6, compiler-rt/lib/builtins), unchanged;
         Apache-2.0 WITH LLVM-exception, CompilerRt/LICENSE.TXT -->
    <EmbeddedResource Include="CompilerRt\*.c;CompilerRt\*.h;CompilerRt\*.inc" LogicalName="compiler-rt/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
