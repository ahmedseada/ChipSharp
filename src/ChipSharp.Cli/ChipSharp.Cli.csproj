<Project Sdk="Microsoft.NET.Sdk">
  <!-- The chipsharp command -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>chipsharp</AssemblyName>
    <RootNamespace>ChipSharp.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chipsharp</ToolCommandName>

    <!-- the .NET tool: dotnet pack puts ChipSharp.<version>.nupkg in artifacts\nupkg; see README, "Install as a tool" -->
    <PackageId>ChipSharp</PackageId>
    <Version>0.3.0</Version>
    <Description>ChipSharp: C# compiled ahead of time for microcontrollers (a PC .exe or a Raspberry Pi Pico .uf2).</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\nupkg</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChipSharp.Build\ChipSharp.Build.csproj" />
    <ProjectReference Include="..\ChipSharp.Frontend\ChipSharp.Frontend.csproj" />
    <ProjectReference Include="..\ChipSharp.Targets\ChipSharp.Targets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ship the target files next to chipsharp.exe -->
    <None Include="..\..\targets\**\*.json" LinkBase="targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
