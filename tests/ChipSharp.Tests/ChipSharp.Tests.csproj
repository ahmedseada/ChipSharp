<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChipSharp.Abstractions\ChipSharp.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Backend.C\ChipSharp.Backend.C.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Backend.Llvm\ChipSharp.Backend.Llvm.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Build\ChipSharp.Build.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Cli\ChipSharp.Cli.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Components\ChipSharp.Components.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Flasher.Avrdude\ChipSharp.Flasher.Avrdude.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Flasher.Uf2Copy\ChipSharp.Flasher.Uf2Copy.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Frontend\ChipSharp.Frontend.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Hardware\ChipSharp.Hardware.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Image.Hex\ChipSharp.Image.Hex.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Image.Uf2\ChipSharp.Image.Uf2.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Runtime.ArmV6M\ChipSharp.Runtime.ArmV6M.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Runtime.Atmega328p\ChipSharp.Runtime.Atmega328p.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Runtime.Avr\ChipSharp.Runtime.Avr.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Runtime.Rp2040\ChipSharp.Runtime.Rp2040.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Runtime.Windows\ChipSharp.Runtime.Windows.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Simulators\ChipSharp.Simulators.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Targets\ChipSharp.Targets.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Toolchain.Clang\ChipSharp.Toolchain.Clang.csproj" />
    <ProjectReference Include="..\..\src\ChipSharp.Toolchain.Sdcc\ChipSharp.Toolchain.Sdcc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- twice as many tests at once as there are processors: the tests that build and run programs mostly wait on
         clang, the programs, the simulator and the virus scanner, and leave half the processors idle with one each -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the real target files, so the tests check what ships -->
    <None Include="..\..\targets\**\*.json" LinkBase="targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
