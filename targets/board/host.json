{
  // The PC ChipSharp runs on: a Windows x64 console program with no C runtime, built with clang and lld.
  // Milestone M0 compiles every program here first and compares its output with real .NET.
  "name": "host",
  "inherits": "x86_64",
  "toolchain": "clang",
  "runtime": "windows-x64",
  "triple": "x86_64-pc-windows-msvc",
  "capabilities": {
    "heap": "256M",       // the memory of the program's heap (M3), taken from Windows at the start (its pages only when used)
    "console": true,      // Console.Write and Console.WriteLine go to standard output
    "clock": true         // DateTime.Now from Windows' clock and time zone; Stopwatch from the performance counter
  },
  "clang": {
    // passed to clang after --target; -nostdlib: no C runtime, the windows-x64 runtime is all the program needs;
    // -ffunction-sections and -fdata-sections: each function and variable on its own, so that the linker keeps only
    // those the program uses (the math functions of the runtime, say)
    "flags": ["-O2", "-nostdlib", "-fuse-ld=lld", "-ffunction-sections", "-fdata-sections", "-Wno-override-module"]
  },
  "link": {
    "entry": "chipsharp_start",    // in the runtime: runs chipsharp_entry, then ExitProcess with its result
    "subsystem": "console",
    "machine": "i386:x86-64",      // llvm-dlltool's name for the CPU the import libraries are made for
    "imports": {
      // DLL -> the functions the program calls in it; the toolchain makes an import library from this list
      // (VirtualAlloc: the heap's memory, taken once at the start by a program that makes objects;
      // SetThreadStackGuarantee and AddVectoredExceptionHandler: a stack overflow ends the program as .NET ends it;
      // the rest: the clock, DateTime.Now and Stopwatch)
      "kernel32.dll": ["GetStdHandle", "WriteFile", "ExitProcess", "VirtualAlloc", "AddVectoredExceptionHandler",
        "SetThreadStackGuarantee", "GetSystemTimePreciseAsFileTime", "GetTimeZoneInformation", "QueryPerformanceCounter",
        "QueryPerformanceFrequency", "GetTickCount64"]
    }
  }
}
