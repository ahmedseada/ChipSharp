{
  // Espressif ESP32-C5-DevKitC-1 (docs.espressif.com/projects/esp-dev-kits, esp32c5/esp32-c5-devkitc-1, user guide): an
  // ESP32-C5-WROOM-1 module (N8R8: 8 MB flash, 8 MB PSRAM; GPIO 15-22 are the module's flash and PSRAM, not the
  // board's) and two USB-C ports: "USB Type-C to UART Port", a USB-to-UART bridge on UART0 (GPIO 11 TX, GPIO 12 RX),
  // through which esptool flashes the board (it resets the chip into the ROM's download mode); and "ESP32-C5 USB Type-C
  // Port", the chip's own USB Serial/JTAG (GPIO 13 D-, GPIO 14 D+). Its Boot ("download") button, held at reset, starts
  // the ROM's download mode instead of the program: GPIO 26-28 choose the boot mode (DS, strapping pins), GPIO 28 low is
  // download mode (esptool's boot mode selection for the ESP32-C5)
  "name": "esp32c5-devkitc",
  "inherits": "esp32c5",
  // chipsharp build writes the ESP image (Name.bin), chipsharp flash writes it with esptool through either USB-C port;
  // the module's flash is 8 MB (N8R8)
  "image": "esp",
  "flasher": "esptool",
  "esp": { "flashSize": "8MB" },
  // the CPU's clock the runtime sets (esp32c5_runtime.c): 160 MHz, PLL_F160M
  "clockHz": 160000000,
  "pinFunctions": {
    // the pins a program may use as plain pins and watch (chipsharp check holds the pins a program gives as constants to
    // these; the runtime takes any of GPIO0-GPIO28). Left out: GPIO2, GPIO3, GPIO7 and GPIO25-GPIO28, the chip's strapping
    // pins (they choose the boot mode at reset: the Boot button is GPIO28, and GPIO27 is the RGB LED's data); GPIO11 and
    // GPIO12, UART0, the "UART" port's bridge; GPIO13 and GPIO14, the USB Serial/JTAG port (D- and D+), the console;
    // GPIO15-GPIO22, the module's flash and PSRAM. What is left: GPIO0, 1, 4, 5, 6, 8, 9, 10, 23 and 24
    "pin": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24],
    "pinEvent": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24],
    // the analog inputs the board leaves a program (ADC1's channels on GPIO1-GPIO6, less the strapping GPIO2 and GPIO3),
    // and the PWM outputs: the same pins as plain pins, since the LEDC and the buses reach any pin through the GPIO matrix
    "adc": [1, 4, 5, 6],
    "pwm": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24]
  },
  // the buses on the pins the board leaves a program (bus 0 each, as the chip's table says)
  "i2c": {
    "buses": [ { "sda": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24], "scl": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24] } ]
  },
  "spi": {
    "buses": [ { "sck": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24], "tx": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24],
                 "rx": [0, 1, 4, 5, 6, 8, 9, 10, 23, 24] } ]
  },
  "pins": {
    // the board's one LED is an addressable RGB LED (a WS2812-like chain of one, "driven by GPIO27"), not a pin an output
    // turns on: a program sends it colors (24 bits, timed pulses). GPIO 27 is a strapping pin too
    "RGB_LED": 27
  }
}
