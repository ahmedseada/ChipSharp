{
  // Arduino Uno (R3): ATmega328P at 16 MHz (a crystal), the LED "L" on D13 (PB5), the USB serial port on USART0
  // (D0 = RX, D1 = TX). In Wokwi: press F1 in the code editor, "Upload Firmware and Start Simulation", and pick the
  // .hex. The Uno's own bootloader (optiboot) takes the last 512 bytes of the flash: a program uploaded through USB
  // must leave them free
  "name": "uno",
  "inherits": "atmega328p",
  "clockHz": 16000000,
  "memory": {
    // the program may use the flash up to the bootloader: 32 KB less optiboot's 512 bytes (the chip itself has 32K)
    "flash": { "size": "32256" }
  },
  "pins": {
    "LED": 13
  },
  // chipsharp flash -t uno: avrdude, through the USB port to optiboot, which speaks STK500 version 1 ("arduino") at
  // 115200 baud; the chip is the "mmcu"
  "flasher": "avrdude",
  "avrdude": { "programmer": "arduino", "baud": 115200 }
}
