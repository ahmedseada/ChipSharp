{
  // WCH CH32V003: one QingKe V2A core (RV32EC, up to 48 MHz), 16 KB of flash, 2 KB of SRAM, no heap. Milestone M5. The
  // facts below come from WCH's documents (wch-ic.com), named where each is used: the CH32V003 Reference Manual (RM,
  // CH32V003RM V1.5), the CH32V003 Datasheet (DS, CH32V003DS0 V1.8), the QingKe V2 Microprocessor Manual (QKV2,
  // QingKeV2_Processor_Manual V1.1), and WCH's own start-up and system files for the chip (openwch/ch32v003,
  // EVT/EXAM/SRC: Startup/startup_ch32v00x.S, Ld/Link.ld, system_ch32v00x.c). Its registers are WCH's SVD
  // (chips/svd/CH32V003xx.svd), its pins and the rest ChipSharp's description of the chip (chips/ch32v003.json), from
  // which src/ChipSharp.Chips makes the runtime's headers (ch32v003_registers.h, ...).
  //
  // The processor: RV32EC (RM overview, "QingKe V2A core, RV32EC instruction set"; QKV2 1.1): RV32E, 16 registers, with
  // C, Zicsr, machine mode only; no M (no Zmmul either: QKV2 lists RV32, E, C and XW alone), so the code multiplies
  // and divides with the runtime's helpers; no A, F or D. XW, WCH's own 16-bit encodings of byte and half-word loads
  // and stores (c.lbu, c.lhu, c.sb, c.sh and their sp forms: QKV2 1.1; clang's Xwchc), would save 1.2% of a program's
  // code and is not used (see "march" below). A load or store at an address not a multiple of its size is an exception
  // (QKV2 Table 2-1, codes 4 and 6), so unalignedAccess stays false.
  //
  // Memory (RM 1.2, Figure 1-2): flash 16 KB at 0x08000000, also at 0x00000000 when the chip boots from it (the alias;
  // from the system bootloader, 1920 bytes at 0x1FFFF000, when the option bytes' START_MODE asks for it: RM 16.5);
  // SRAM 2 KB at 0x20000000. The program is linked at the alias, 0x00000000, as WCH's own Link.ld does (FLASH ORIGIN =
  // 0x00000000, LENGTH = 16K): the core starts there, and the code's absolute addresses (the vector table's) are the
  // ones it runs at. The same bytes are flash 0x08000000-0x08003fff, where a programmer writes them.
  //
  // Reset and interrupts. The core starts at 0x00000000 (RM Table 6-1, entry 0). The PFIC (RM 6, QKV2 3; 0xE000E000)
  // has 39 vector numbers here: 2 NMI, 3 HardFault (every exception), 12 SysTick, 14 SW, 16-38 the peripherals' 23;
  // mcause has the number (bit 31 set for an interrupt; an exception's code, 0-11, with bit 31 clear). mtvec (QKV2 2.2,
  // 3.2): MODE0 (bit 0) 1 makes an interrupt's entry mtvec's base + 4 * its number, MODE1 (bit 1) 1 makes the table hold
  // the handlers' addresses (not jump instructions), and the base must be 1 KB aligned; after reset mtvec is 0. So the
  // vector table is the first 156 bytes of flash ("link.head", ch32v003_vector_table.S): entry 0, where the core
  // starts, is a jump to chipsharp_reset (a 4-byte jal, as WCH's start-up has "j handle_reset"), and entries 1-38 the
  // address of the riscv32 runtime's trap entry, chipsharp_trap; the chip's first steps put mtvec at the table
  // (0x00000000 | 3, WCH's own MODE 11). Every interrupt and exception then comes to chipsharp_trap, which saves the
  // registers and dispatches by mcause to chipsharp_isr_irq<n> ("vectors": 39), as on every RISC-V chip of ChipSharp.
  // HPE, the hardware prologue/epilogue (QKV2 3.4: INTSYSCR.HWSTKEN, CSR 0x804, which also has INESTEN, the nesting),
  // is off: its handlers must be compiled by WCH's toolchain as interrupt("WCH-Interrupt-fast"), which clang has not, and
  // the trap entry saves the same ten registers itself. Both bits are 0 after reset (RM 6.5.3.1), and the start-up
  // writes 0 to INTSYSCR all the same (WCH's start-up turns both on, and a bootloader may have): handlers do not nest,
  // and as the first level is then the last, the core clears mstatus.MIE on the way in (QKV2 2.2: MIE is not cleared
  // before the last level), as the trap entry expects.
  //
  // The clock (RM 3): after reset the system clock is the HSI, 24 MHz, and the AHB prescaler (RCC_CFGR0.HPRE, reset 0010)
  // divides it by 3: the core runs at 8 MHz. The chip's first steps (ch32v003_boot.c, WCH's SetSysClockTo_48MHZ_HSI)
  // raise it to 48 MHz: flash 1 wait state (FLASH_ACTLR.LATENCY 01, for 24-48 MHz: RM 16.3.1), HPRE 0000 (HCLK =
  // SYSCLK), the PLL from the HSI (PLLSRC 0, which multiplies by 2), PLLON and wait for PLLRDY, SW 10 (the PLL) and
  // wait for SWS 10. HSITRIM keeps its reset value (16: 24 MHz +- 1%).
  //
  // What runs at reset: neither watchdog. The IWDG is off after a reset unless the option bytes' IWDG_SW is 0 (RM 4.2.1,
  // 16.5: then the hardware starts it, and nothing stops it); ChipSharp neither reads nor changes the option bytes,
  // and the runtime does not feed a watchdog. The WWDG is off after a reset (RM 5.2.1). The 1-wire debug interface (SWIO, PD1) is on
  // after every reset (DS 1.4.18).
  //
  // What the runtime has (src/ChipSharp.Runtime.Ch32v003, M5's wave 0): the start-up, the clock at 48 MHz, the trap's
  // dispatch, the helpers; pins, the delays, the clock, the console on USART1 and the events come with wave 1, and the
  // capabilities below say what is there.
  "name": "ch32v003",
  "inherits": "riscv32e",
  "runtime": "ch32v003",
  // rv32ec_zicsr (riscv32e's). Not xwchc (clang's -march=rv32ec_zicsr_xwchc): on the 89 programs of the corpora that
  // fit the chip it takes 1.2% off the code (0.1% to 2.3% a program: the compressed byte and half-word loads and
  // stores), not worth an encoding every simulator and disassembler would need to know
  "march": "rv32ec_zicsr",
  "memory": {
    // the flash at its alias, where the core runs it (see above); the SRAM
    "flash": { "origin": "0x00000000", "size": "16K" },
    "sram": { "origin": "0x20000000", "size": "2K" }
  },
  "link": {
    "code": "flash",
    "data": "sram",
    // a quarter of the 2 KB, as the Uno keeps of its 2 KB: room for the deepest call chain of the runtime's float text
    // (a double is written with 64-bit arithmetic in its locals) and an interrupt's 40-byte frame on top
    "stack": "512",
    // the vector table, at the start of flash (0x00000000, 1 KB aligned as mtvec needs): 39 entries of 4 bytes
    "head": [ { "section": ".ch32v003_vectors", "size": 156 } ],
    // the trap entry: the table holds its address, so 4 bytes (riscv32's 64 is for a CLIC's mtvec)
    "vectorAlign": 4
  },
  // the entries of the trap's dispatch (riscv32 runtime): the PFIC's vector numbers 0-38, chipsharp_isr_irq0 to 38
  "vectors": 39,
  "interrupts": {
    // the events an [Interrupt] method can handle: the PFIC's vector number of the source (RM Table 6-1), and the runtime
    // function that runs first and clears the event (wave 1's runtime defines them)
    "timer": { "irq": 12, "clear": "chipsharp_clear_timer_event" },  // SysTick: the core's 32-bit counter and its compare
                                                                      // (PFIC_STK_*), which leaves TIM1 and TIM2 to PWM
    "pin": { "irq": 20, "clear": "chipsharp_clear_pin_event" },       // EXTI7_0: EXTI lines 0-7, a pin each (AFIO_EXTICR)
    "uart": { "irq": 32, "clear": "chipsharp_clear_uart_event" }      // USART1
  },
  "capabilities": {
    "heap": false,          // 2 KB of SRAM: no objects
    "console": false,       // USART1, with M5's wave 1
    "clock": false          // SysTick, with M5's wave 1
  }
}
