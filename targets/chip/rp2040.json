{
  // Raspberry Pi RP2040: dual Cortex-M0+, 264 KB RAM, flash is an external chip on the board
  "name": "rp2040",
  "inherits": "armv6m",
  "runtime": "rp2040",
  "cpu": "cortex-m0plus",
  "memory": {
    "flash": { "origin": "0x10000000" },   // size comes from the board
    "ram":   { "origin": "0x20000000", "size": "264K" }
  },
  "boot": { "stage2": "boot2_w25q080.bin" },   // 256-byte second-stage bootloader at the start of flash
  "link": {
    // boot2 fills the first 256 bytes of flash, so the vector table lands at 0x10000100, where boot2 jumps
    "head": [ { "section": ".boot2", "size": 256 } ]
  },
  "interrupts": {
    // the events an [Interrupt] method can handle: the interrupt (IRQ) whose vector runs it, and the runtime function
    // that runs first, which clears the event (and arms a repeating timer's next time)
    "timer": { "irq": 1, "clear": "chipsharp_clear_timer_event" },   // TIMER_IRQ_1: alarm 1 (the delays use alarm 0)
    "pin": { "irq": 13, "clear": "chipsharp_clear_pin_event" }       // IO_IRQ_BANK0: GPIO 0-29 edges
  },
  "image": "uf2",
  "uf2FamilyId": "0xe48bff56",
  "flasher": "uf2-copy",
  "svd": "svd/RP2040.svd",
  "capabilities": {
    // fast float routines in the boot ROM; not used: they treat subnormal numbers as zero, so results would differ
    // from .NET's (the armv6m runtime links compiler-rt's exact ones instead)
    "romFloat": true,
    // the heap's budget: of the 264K of RAM, 8K is the stack (link.stack) and 32K is left for static fields
    "heap": "224K",
    "console": true,      // Console.Write and Console.WriteLine go to UART0 (GPIO 0, 115200 baud)
    "i2c": true,          // ChipSharp.Hardware.I2c: two I2C controllers ("i2c" below)
    "spi": true           // ChipSharp.Hardware.Spi: two SPI controllers ("spi" below)
  },
  // the I2C and SPI controllers: the clocks they make, lowest and highest, in hertz, and the pins each (bus 0, bus 1)
  // can use, GPIO function 3 for I2C and 1 for SPI; chipsharp check holds the constants of I2c.Open and Spi.Open to them
  "i2c": {
    "frequency": [2000, 1000000],
    "buses": [
      { "sda": [0, 4, 8, 12, 16, 20, 24, 28], "scl": [1, 5, 9, 13, 17, 21, 25, 29] },
      { "sda": [2, 6, 10, 14, 18, 22, 26], "scl": [3, 7, 11, 15, 19, 23, 27] }
    ]
  },
  "spi": {
    "frequency": [2000, 62500000],
    "buses": [
      { "sck": [2, 6, 18, 22], "tx": [3, 7, 19, 23], "rx": [0, 4, 16, 20] },
      { "sck": [10, 14, 26], "tx": [11, 15, 27], "rx": [8, 12, 24, 28] }
    ]
  }
}
